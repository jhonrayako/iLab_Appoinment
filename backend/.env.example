# Supabase Session pooler (Project Settings > Database > Connection string)
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require

# Required in production; configure a unique randomly generated value in Render
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=7d

NODE_ENV=development
PORT=5000
FRONTEND_VISITOR_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5173
CORS_ORIGINS=https://i-lab-appoinment.vercel.app
