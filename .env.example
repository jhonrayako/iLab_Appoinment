# Supabase browser client (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the separately hosted Express backend. Vercel builds require
# this value; either the API origin or its /api URL is accepted.
VITE_API_URL=http://localhost:5000/api

# Production deployment notice
# Never expose secrets here. Keep JWT_SECRET, database credentials, and service keys in the hosting provider's secret manager.
